<h1>スケジュール一覧</h1>

<p>本日: <%= Date.current.strftime("%Y/%m/%d") %></p>
<p>予定の合計数: <%= @posts.count %>件</p>

<p><%= link_to "新規予定の追加", new_post_path %></p>

<table border="1">
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th>操作</th>
    </tr>
  </thead>

  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.id %></td>
        <td><%= post.title %></td>
        <td><%= post.start_date.strftime("%Y/%m/%d") %></td>
        <td><%= post.end_date.strftime("%Y/%m/%d") %></td>
        <td align="center"><%= post.is_all_day ? "○" : "" %></td>
        <td><%= post.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td>
          <%= link_to "詳細", post_path(post) %>
          <%= link_to "編集", edit_post_path(post) %>
          <%= link_to "削除", post_path(post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>