<h1>予定詳細</h1>

<p><strong>タイトル:</strong> <%= @post.title %></p>
<p><strong>開始日:</strong> <%= @post.start_date.strftime("%Y/%m/%d") %></p>
<p><strong>終了日:</strong> <%= @post.end_date.strftime("%Y/%m/%d") %></p>
<p><strong>終日:</strong> <%= @post.is_all_day ? "○" : "なし" %></p>
<p><strong>スケジュールメモ:</strong></p>
<p><%= simple_format(@post.memo) %></p>

<p>
  <%= link_to "編集", edit_post_path(@post) %> |
  <%= link_to "一覧に戻る", posts_path %>
</p>