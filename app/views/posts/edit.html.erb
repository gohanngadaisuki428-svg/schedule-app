<h1>予定編集</h1>

<% if @post.errors.any? %>
  <div style="color: red;">
    <h2><%= @post.errors.count %>件のエラーが発生しました:</h2>
    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: @post, local: true) do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
    <% if @post.errors[:title].any? %>
      <span style="color: red;"><%= @post.errors[:title].first %></span>
    <% end %>
  </div>

  <div>
    <%= f.label :start_date, "開始日" %><br>
    <%= f.date_field :start_date %>
    <% if @post.errors[:start_date].any? %>
      <span style="color: red;"><%= @post.errors[:start_date].first %></span>
    <% end %>
  </div>

  <div>
    <%= f.label :end_date, "終了日" %><br>
    <%= f.date_field :end_date %>
    <% if @post.errors[:end_date].any? %>
      <span style="color: red;"><%= @post.errors[:end_date].first %></span>
    <% end %>
  </div>

  <div>
    <%= f.check_box :is_all_day %>
    <%= f.label :is_all_day, "終日" %>
  </div>

  <div>
    <%= f.label :memo, "スケジュールメモ" %><br>
    <%= f.text_area :memo %>
    <% if @post.errors[:memo].any? %>
      <span style="color: red;"><%= @post.errors[:memo].first %></span>
    <% end %>
  </div>

  <div>
    <%= f.submit "更新" %>
  </div>
<% end %>

<br>
<%= link_to "詳細に戻る", post_path(@post) %> |
<%= link_to "一覧に戻る", posts_path %>